{
  "name": "fixup-twitter-link",
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "start": "node .",
    "dev": "SWCRC=true node --import=@swc-node/register/esm-register -r dotenv/config src/main.ts dotenv_config_override=true",
    "build": "rm -rf ./dist && swc ./src --out-dir=dist && node -e '!fs.existsSync(\".sentryclirc\") || process.exit(1)' || pnpm sentry:sourcemaps",
    "build:debug": "rm -rf ./dist && swc --source-maps=true ./src --out-dir=dist && node -e '!fs.existsSync(\".sentryclirc\") || process.exit(1)' || pnpm sentry:sourcemaps",
    "type:check": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix --cache .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "jest",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org mmmm-q0 --project fixup-twitter-link ./dist && sentry-cli sourcemaps upload --org mmmm-q0 --project fixup-twitter-link ./dist"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "29.7.0",
    "@sentry/cli": "3.8.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "dotenv": "18.0.9",
    "dprint": "0.64.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.5",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0"
  },
  "dependencies": {
    "@discordjs/collection": "2.1.1",
    "@discordjs/core": "2.6.0",
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@sentry/node": "9.47.2",
    "@sentry/profiling-node": "9.47.2"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "@sentry/profiling-node",
      "@swc/core",
      "dprint"
    ]
  }
}
